# Combinational compactor equivalence: DUT vs an independent stable filter, symbolic 200-bit board.
[options]
timeout 3600
mode prove
depth 2

[engines]
smtbmc boolector

[script]
read -formal -sv rank_level.sv row_rank20.sv rank_match.sv row_select_groups.sv row_select_final.sv line_clear_parallel.sv compactor_miter.sv
prep -top compactor_miter

[files]
rtl/rank_level.sv
rtl/row_rank20.sv
rtl/rank_match.sv
rtl/row_select_groups.sv
rtl/row_select_final.sv
rtl/line_clear_parallel.sv
formal/compactor/compactor_miter.sv
